{
  "version": 2,
  "builds": [
    {
      "src": "public/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/admin/dashboard",
      "status": 308,
      "dest": "/dashboard"
    },
    {
      "src": "/dashboard",
      "dest": "/public/dashboard.html"
    },
    {
      "src": "/advanced",
      "dest": "/public/advanced.html"
    },
    {
      "src": "/admin/database/([a-z0-9_]+)",
      "dest": "/public/admin/database/$1.html"
    },
    {
      "src": "/tables/([a-z0-9_]+)",
      "dest": "/public/admin/database/$1.html"
    },
    {
      "src": "/api/auth/(.*)",
      "dest": "https://api-binzeo.vercel.app/v1/auth/$1"
    },
    {
      "src": "/api/user/(.*)",
      "dest": "https://api-binzeo.vercel.app/v1/user/$1"
    },
    {
      "src": "/api/admin/me",
      "dest": "https://api-binzeo.vercel.app/v1/admin/me"
    },
    {
      "src": "/api/admin/(.*)",
      "dest": "https://api-binzeo.vercel.app/api/v1/projects/jabiyen/admin/admin/$1"
    },
    {
      "src": "/api/(.*)",
      "dest": "https://api-binzeo.vercel.app/api/v1/projects/jabiyen/admin/admin/$1"
    },
    {
      "src": "/components.js",
      "dest": "/public/components.js"
    },
    {
      "src": "/fonts.js",
      "dest": "/public/fonts.js"
    },
    {
      "src": "/herobanner",
      "dest": "/public/herobanner.html"
    },
    {
      "src": "/herovideo",
      "dest": "/public/herovideo.html"
    },
    {
      "src": "/category-menu-item",
      "dest": "/public/category-menu-item.html"
    },
    {
      "src": "/logo.png",
      "dest": "/public/logo.png"
    },
    {
      "src": "/signup",
      "dest": "/public/signup.html"
    },
    {
      "src": "/signin",
      "dest": "/public/signin.html"
    },
    {
      "src": "/auth/callback.html",
      "dest": "/public/auth/callback.html"
    },
    {
      "src": "/login",
      "dest": "/public/signin.html"
    },
    {
      "src": "/account",
      "dest": "/public/account.html"
    },
    {
      "src": "/product",
      "dest": "/public/product.html"
    },
    {
      "src": "/product-variant",
      "dest": "/public/product-variant.html"
    },
    {
      "src": "/story",
      "dest": "/public/story.html"
    },
    {
      "src": "/faq",
      "dest": "/public/faq.html"
    },
    {
      "src": "/about",
      "dest": "/public/about.html"
    },
    {
      "src": "/shipping-policy",
      "dest": "/public/shipping-policy.html"
    },
    {
      "src": "/return-policy",
      "dest": "/public/return-policy.html"
    },
    {
      "src": "/blog",
      "dest": "/public/blog.html"
    },
    {
      "src": "/privacy-policy",
      "dest": "/public/privacy-policy.html"
    },
    {
      "src": "/terms-and-conditions",
      "dest": "/public/terms-and-conditions.html"
    },
    {
      "src": "/refund-policy",
      "dest": "/public/refund-policy.html"
    },
    {
      "src": "/cookie-policy",
      "dest": "/public/cookie-policy.html"
    },
    {
      "src": "/store-locator",
      "dest": "/public/store-locator.html"
    },
    {
      "src": "/(.*\\.(js|css|png|jpg|jpeg|gif|svg|ico|woff|woff2|ttf|eot|webp|mp4|webm|json|xml|txt))",
      "dest": "/public/$1"
    },
    {
      "src": "/products",
      "dest": "/public/index.html"
    },
    {
      "src": "/wishlist",
      "dest": "/public/index.html"
    },
    {
      "src": "/checkout",
      "dest": "/public/checkout.html"
    },
    {
      "src": "/journal",
      "dest": "/public/index.html"
    },
    {
      "src": "/search",
      "dest": "/public/index.html"
    },
    {
      "src": "/",
      "dest": "/public/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/public/index.html"
    }
  ]
}

{
  "version": 2,
  "builds": [
    {
      "src": "public/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/admin/dashboard/(.*)", "status": 308, "dest": "/$1" },
    { "src": "/dashboard/(.*)", "status": 308, "dest": "/$1" },
    { "src": "/admin/dashboard", "status": 308, "dest": "/dashboard" },
    { "src": "/advanced", "status": 308, "dest": "/sections" },
    { "src": "/database", "status": 308, "dest": "/sections" },
    { "src": "/admin/database", "status": 308, "dest": "/sections" },
    { "src": "/admin/database/([a-z0-9_]+)", "dest": "/public/database_all_tables.html?table=$1" },
    { "src": "/admin/database/(.*)", "status": 308, "dest": "/sections" },
    { "src": "/database/(.*)", "status": 308, "dest": "/sections" },
    { "src": "/tables", "status": 308, "dest": "/sections" },
    { "src": "/tables/(.*)", "status": 308, "dest": "/sections" },


    { "src": "/sections", "dest": "/public/advanced.html" },
    { "src": "/dashboard", "dest": "/public/dashboard.html" },
    { "src": "/about", "dest": "/public/about_us.html" },
    { "src": "/blog", "dest": "/public/database_blog.html" },
    { "src": "/cookie-policy", "dest": "/public/cookie_policy.html" },
    { "src": "/faq", "dest": "/public/database_faq.html" },
    { "src": "/privacy-policy", "dest": "/public/privacy_policy.html" },
    { "src": "/refund-policy", "dest": "/public/refund_policy.html" },
    { "src": "/return-policy", "dest": "/public/return_policy.html" },
    { "src": "/shipping-policy", "dest": "/public/shipping_policy.html" },
    { "src": "/store-locator", "dest": "/public/store_locator.html" },
    { "src": "/story", "dest": "/public/database_story.html" },
    { "src": "/terms-and-conditions", "dest": "/public/terms_conditions.html" },
    { "src": "/announcement-bar", "dest": "/public/announcement_bar.html" },
    { "src": "/hero-secondary", "dest": "/public/hero_secondary.html" },
    { "src": "/home-showcase", "dest": "/public/home_showcase_header.html" },
    { "src": "/home-showcase-items", "dest": "/public/home_showcase_items.html" },
    { "src": "/footer/content", "dest": "/public/footer_content.html" },
    { "src": "/footer/menus", "dest": "/public/footer_menus.html" },
    { "src": "/footer/quick-links", "dest": "/public/footer_quick_links.html" },
    { "src": "/footer/social-links", "dest": "/public/footer_social_links.html" },
    { "src": "/footer/payment-methods", "dest": "/public/footer_payment_methods.html" },
    { "src": "/footer/shipping-partners", "dest": "/public/footer_shipping_partners.html" },
    { "src": "/footer/certifications", "dest": "/public/footer_certifications.html" },
    { "src": "/footer/app-links", "dest": "/public/footer_app_links.html" },
    { "src": "/footer/countries", "dest": "/public/footer_country_selector.html" },
    { "src": "/footer/trust-badges", "dest": "/public/footer_trust_badges.html" },
    { "src": "/footer/settings", "dest": "/public/footer_settings.html" },
    { "src": "/shipping-fees", "dest": "/public/shipping_fees.html" },
    { "src": "/currency-rates", "dest": "/public/currency_rates.html" },

    { "src": "/api/auth/(.*)", "dest": "https://api-binzeo.vercel.app/v1/auth/$1" },
    { "src": "/api/user/(.*)", "dest": "https://api-binzeo.vercel.app/v1/user/$1" },
    { "src": "/api/admin/me", "dest": "https://api-binzeo.vercel.app/v1/admin/me" },
    { "src": "/api/admin/(.*)", "dest": "https://api-binzeo.vercel.app/api/v1/projects/jabiyen/admin/admin/$1" },
    { "src": "/api/(.*)", "dest": "https://api-binzeo.vercel.app/api/v1/projects/jabiyen/admin/admin/$1" },

    { "src": "/components.js", "dest": "/public/components.js" },
    { "src": "/fonts.js", "dest": "/public/fonts.js" },
    { "src": "/herobanner", "dest": "/public/herobanner.html" },
    { "src": "/herovideo", "dest": "/public/herovideo.html" },
    { "src": "/category-menu-item", "dest": "/public/category-menu-item.html" },
    { "src": "/logo.png", "dest": "/public/logo.png" },
    { "src": "/signup", "status": 308, "dest": "/signin" },
    { "src": "/signin", "dest": "/public/signin.html" },
    { "src": "/auth/callback.html", "dest": "/public/auth/callback.html" },
    { "src": "/login", "dest": "/public/signin.html" },
    { "src": "/account", "dest": "/public/account.html" },
    { "src": "/product", "dest": "/public/product.html" },
    { "src": "/product-variant", "dest": "/public/product-variant.html" },
    { "src": "/(.*\\.(js|css|png|jpg|jpeg|gif|svg|ico|woff|woff2|ttf|eot|webp|mp4|webm|json|xml|txt))", "dest": "/public/$1" },
    { "src": "/products", "dest": "/public/index.html" },
    { "src": "/wishlist", "dest": "/public/index.html" },
    { "src": "/checkout", "status": 308, "dest": "/dashboard" },
    { "src": "/journal", "dest": "/public/index.html" },
    { "src": "/search", "dest": "/public/index.html" },
    { "src": "/", "dest": "/public/index.html" },
    { "src": "/(.*)", "dest": "/public/index.html" }
  ]
}
